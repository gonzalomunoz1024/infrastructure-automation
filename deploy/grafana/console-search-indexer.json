{
  "title": "Console search indexer",
  "uid": "console-search-indexer",
  "description": "Search latency against the plan's targets (search p95 under 500 ms, a list's counts under 300 ms), throughput, the query budget and the index's freshness. Prometheus scrapes /actuator/prometheus.",
  "tags": ["console", "search", "load"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(console_search_documents, job)", "refId": "job" },
        "definition": "label_values(console_search_documents, job)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "p95 by kind of query (target: search 500 ms, counts 300 ms)",
      "description": "From the service's own timer, console_search_duration, whose buckets sit around the targets.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le, what) (rate(console_search_duration_seconds_bucket{job=~\"$job\", what=~\"search|suggest|counts|interpret\"}[1m])))",
          "legendFormat": "{{what}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 at the HTTP edge, by path",
      "description": "Spring's http.server.requests, which includes reading the request and writing the answer.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=~\"$job\", uri=~\"/v1/.*\"}[1m])))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Searches within 500 ms (last 15 min)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(console_search_duration_seconds_bucket{job=~\"$job\", what=\"search\", le=\"0.5\"}[15m])) / sum(rate(console_search_duration_seconds_count{job=~\"$job\", what=\"search\"}[15m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Counts within 300 ms (last 15 min)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(console_search_duration_seconds_bucket{job=~\"$job\", what=\"counts\", le=\"0.3\"}[15m])) / sum(rate(console_search_duration_seconds_count{job=~\"$job\", what=\"counts\"}[15m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Index lag",
      "description": "How far the newest applied event is behind now.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 60 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(console_search_lag_seconds{job=~\"$job\"})"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Documents",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(console_search_documents{job=~\"$job\"})"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Queries a second, by kind and outcome",
      "description": "throttled is a 429 of an account's query budget (console.search.budget.*), per replica.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (kind, outcome) (rate(console_search_queries_total{job=~\"$job\"}[1m]))",
          "legendFormat": "{{kind}} {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Events applied a second, by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (outcome) (rate(console_search_events_total{job=~\"$job\"}[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    }
  ]
}
