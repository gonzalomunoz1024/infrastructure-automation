{
  "name": "@iaf/console",
  "private": true,
  "version": "0.1.0",
  "description": "The customer console web app: the AWS console framework drawn in Atlas",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_CONSOLE_MOCK=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@iaf/console-kit": "*",
    "@iaf/ui": "*",
    "@iaf/wfrn": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
