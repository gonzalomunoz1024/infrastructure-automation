  "format": [
    {
      "name": "a vm",
      "parts": { "partition": "wf", "service": "compute", "region": "global", "account": "123456789012", "type": "vm", "id": "vm-01jbx7q2m4k9d3c8f5r6t1w0ya" },
      "expected": "wfrn:wf:compute:global:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0ya"
    },
    {
      "name": "empty region and account are written as empty segments",
      "parts": { "partition": "wf", "service": "organizations", "region": "", "account": "", "type": "account", "id": "123456789012" },
      "expected": "wfrn:wf:organizations:::account/123456789012"
    },
    {
      "name": "format refuses an uppercase service",
      "parts": { "partition": "wf", "service": "Compute", "region": "global", "account": "123456789012", "type": "vm", "id": "vm-01jbx7q2m4k9d3c8f5r6t1w0ya" },
      "error": "wfrn.case"
    },
    {
      "name": "format refuses a wildcard id",
      "parts": { "partition": "wf", "service": "compute", "region": "global", "account": "123456789012", "type": "vm", "id": "*" },
      "error": "wfrn.wildcard"
    },
    {
      "name": "format refuses a bad account",
      "parts": { "partition": "wf", "service": "compute", "region": "global", "account": "12345", "type": "vm", "id": "vm-01jbx7q2m4k9d3c8f5r6t1w0ya" },
      "error": "wfrn.account"
    },
    {
      "name": "format refuses an empty id",
      "parts": { "partition": "wf", "service": "compute", "region": "global", "account": "123456789012", "type": "vm", "id": "" },
      "error": "wfrn.id"
    }
  ],
  "patterns": [
    {
      "name": "every vm of one account in any region",
      "pattern": "wfrn:wf:compute:*:123456789012:vm/*",
      "matches": [
        "wfrn:wf:compute:global:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0ya",
        "wfrn:wf:compute:eu-west-1:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0yd"
      ],
      "misses": [
        "wfrn:wf:compute:global:210987654321:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0ya",
        "wfrn:wf:data:global:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0ya",
        "wfrn:wf:compute:global:123456789012:volume/volume-01jbx7q2m4k9d3c8f5r6t1w0ya"
      ]
    },
    {
      "name": "everything in the partition",
      "pattern": "wfrn:wf:*",
      "matches": [
        "wfrn:wf:compute:global:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0ya",
        "wfrn:wf:iam::123456789012:role/admin",
        "wfrn:wf:organizations:::account/123456789012"
      ],
      "misses": [
        "wfrn:wf-gov:compute:global:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0ye"
      ]
    },
    {
      "name": "everything of one account in one region, any type",
      "pattern": "wfrn:wf:*:global:123456789012:*",
      "matches": [
        "wfrn:wf:compute:global:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0ya",
        "wfrn:wf:storage:global:123456789012:bucket/bucket-01jbx7q2m4k9d3c8f5r6t1w0yc/logs/2026"
      ],
      "misses": [
        "wfrn:wf:compute:eu-west-1:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0yd",
        "wfrn:wf:iam::123456789012:role/admin"
      ]
    },
    {
      "name": "an exact name is its own pattern",
      "pattern": "wfrn:wf:compute:global:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0ya",
      "matches": ["wfrn:wf:compute:global:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0ya"],
      "misses": ["wfrn:wf:compute:global:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0yb"]
    },
    {
      "name": "a question mark matches exactly one character",
      "pattern": "wfrn:wf:compute:global:123456789012:vm/web-0?",
      "matches": ["wfrn:wf:compute:global:123456789012:vm/web-01", "wfrn:wf:compute:global:123456789012:vm/web-0a"],
      "misses": ["wfrn:wf:compute:global:123456789012:vm/web-0", "wfrn:wf:compute:global:123456789012:vm/web-010"]
    },
    {
      "name": "a star inside an id crosses slashes",
      "pattern": "wfrn:wf:storage:global:123456789012:bucket/bucket-01jbx7q2m4k9d3c8f5r6t1w0yc/*",
      "matches": [
        "wfrn:wf:storage:global:123456789012:bucket/bucket-01jbx7q2m4k9d3c8f5r6t1w0yc/logs",
        "wfrn:wf:storage:global:123456789012:bucket/bucket-01jbx7q2m4k9d3c8f5r6t1w0yc/logs/2026"
      ],
      "misses": [
        "wfrn:wf:storage:global:123456789012:bucket/bucket-01jbx7q2m4k9d3c8f5r6t1w0yc",
        "wfrn:wf:storage:global:123456789012:bucket/bucket-01jbx7q2m4k9d3c8f5r6t1w0yd/logs"
      ]
    },
    {
      "name": "an empty region in a pattern matches only an empty region",
      "pattern": "wfrn:wf:iam::123456789012:role/*",
      "matches": ["wfrn:wf:iam::123456789012:role/admin"],
      "misses": ["wfrn:wf:iam:global:123456789012:role/admin"]
    },
    {
      "name": "a star matches the empty string",
      "pattern": "wfrn:wf:compute:global:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0ya*",
      "matches": ["wfrn:wf:compute:global:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0ya", "wfrn:wf:compute:global:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0ya/disk-0"],
      "misses": ["wfrn:wf:compute:global:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0y"]
    },
    {
      "name": "no case folding in patterns",
      "pattern": "wfrn:wf:compute:global:123456789012:vm/*",
      "matches": ["wfrn:wf:compute:global:123456789012:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0ya"],
      "misses": ["wfrn:wf:compute:global:123456789012:vm/VM-01JBX7Q2M4K9D3C8F5R6T1W0YA"]
    }
  ],
  "invalidPatterns": [
