    { "name": "account of thirteen digits", "input": "wfrn:wf:compute:global:1234567890123:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0ya", "code": "wfrn.account" },
    { "name": "account with letters", "input": "wfrn:wf:compute:global:12345678901a:vm/vm-01jbx7q2m4k9d3c8f5r6t1w0ya", "code": "wfrn.account" },
